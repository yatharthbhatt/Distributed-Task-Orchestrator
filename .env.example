# Copy to `.env` and adjust. All values have sensible per-mode defaults, so an
# empty .env is valid — this file documents what you *can* override.

# ---- run mode ----
# 'local'  => SQLite + Celery eager (no external services). Default.
# 'docker' => Redis + Postgres + real distributed workers.
RUN_MODE=local

# ---- broker / backend (only needed in docker mode) ----
# BROKER_URL=redis://redis:6379/0
# RESULT_BACKEND=redis://redis:6379/1

# ---- database ----
# Local default: sqlite:///./orchestrator.db
# Docker default: postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator
# DATABASE_URL=

# Force eager execution regardless of mode (useful for a no-infra demo/tests):
# TASK_ALWAYS_EAGER=true

# ---- fault tolerance ----
MAX_RETRIES=5
RETRY_BACKOFF_BASE=2
RETRY_BACKOFF_MAX=60
RETRY_JITTER=true

# ---- worker tuning ----
WORKER_CONCURRENCY=4
WORKER_PREFETCH_MULTIPLIER=1

# ---- demo ----
# Probability the 'flaky' task fails each attempt (drives retry demos).
FLAKY_FAILURE_RATE=0.4

# ---- api ----
# CORS_ORIGINS=["http://localhost:3000"]

# ---- dashboard (build-time; browser-facing API URL) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
